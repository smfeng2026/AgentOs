export interface SmsMessage {
  id: number;
  body: string;
  time: number;
  outgoing: boolean;
}

export interface SmsThread {
  id: number;
  name: string;
  unread: boolean;
  messages: SmsMessage[];
}

function seedThread(id: number, name: string, body: string): SmsThread {
  return {
    id: id,
    name: name,
    unread: true,
    messages: [{ id: id * 100, body: body, time: new Date(2026, 9, 30, 11, 30 - id).getTime(), outgoing: false }]
  };
}

