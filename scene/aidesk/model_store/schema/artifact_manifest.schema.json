{"$schema": "http://json-schema.org/draft-07/schema#", "title": "artifact_manifest", "type": "object", "required": ["artifact_id", "kind", "base", "files", "created_at"], "properties": {"artifact_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.\\-]*(__[a-z0-9][a-z0-9.\\-]*)+$"}, "kind": {"enum": ["lora_adapter", "merged", "full_finetune", "quantized"]}, "base": {"type": "object", "required": ["repo", "store_path"], "properties": {"repo": {"type": "string"}, "revision": {"type": ["string", "null"]}, "store_path": {"type": "string", "description": "相对 model_store 的基座目录，如 base/qwen3-0.6b"}}}, "parent_artifact": {"type": ["string", "null"], "description": "量化/合并产物指向其来源 artifact；直接微调为 null"}, "training_run": {"type": ["string", "null"], "description": "相对 scene/aidesk 的训练 run 目录；非训练产物可为 null"}, "train_data": {"type": ["object", "null"], "required": ["snapshot", "sha256"], "properties": {"snapshot": {"type": "string"}, "sha256": {"type": "string"}, "rows": {"type": "integer"}}}, "hyperparams": {"type": "object"}, "files": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer"}}}}, "created_at": {"type": "string"}, "notes": {"type": "string"}}}