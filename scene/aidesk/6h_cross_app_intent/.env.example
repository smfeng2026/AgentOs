# OpenAI-compatible chat completions endpoint (Volcano Ark gateway shown as an example)
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=replace-me
# Planner / Generator model
LLM_MODEL=your-model
# Annotator / Reviewer / Adjudicator — a different model family from the generator on purpose
# (falls back to LLM_* when unset)
LLM_JUDGE_MODEL=another-model
LLM_TIMEOUT=180
LLM_MAX_RETRIES=5
# 1 = route requests through HTTP(S)_PROXY / the system proxy; 0 (default) = connect directly.
LLM_TRUST_ENV=0
# Optional reasoning budget for thinking models (enabled|disabled|low|high|max); unset = provider default.
# The gateway rejected thinking.type=low for glm-5.4 / deepseek-v4.1-flash in testing (the client then drops it),
# so leave unset unless your provider documents it. Per agent: LLM_<PLANNER|GENERATOR|ANNOTATOR|REVIEWER|ADJUDICATOR>_THINKING
# LLM_GENERATOR_THINKING=
# json_object | none
LLM_RESPONSE_FORMAT=json_object

# MOCK_LLM=1 only blocks accidental generation without a real API (no mock data is produced).
MOCK_LLM=0
