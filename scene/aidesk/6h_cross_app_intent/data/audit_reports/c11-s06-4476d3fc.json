  "review": {
    "sample_id": "c11-s06-4476d3fc",
    "passed": false,
    "issues": [
      {
        "issue_type": "intent_definition_mismatch",
        "severity": "critical",
        "event_ids": [
          "e008",
          "e012",
          "e024",
          "e025",
          "e027",
          "e028"
        ],
        "description": "盲标把 Gold 的 local_transport/outing/planned 意图“古北水镇周末出行方式调整”改写为 travel/tourism/confirmed 的“古北水镇周末游”，丢失了“取消租车、改乘市郊铁路”这一核心意图。e008/e012 是取消与退款，e024/e025 是新车票支付，e027 明确记录出行方式改为市郊铁路，e028 通知同伴，均指向方式调整，而不是单纯旅游确认。",
        "suggested_action": "恢复 i001 的意图名称、category=local_transport、purpose=outing、status=planned；若确实存在更宽泛的“周末游”意图，应新增为独立意图，不能替代方式调整意图。"
      },
      {
        "issue_type": "state_change_label_inversion",
        "severity": "high",
        "event_ids": [
          "e002",
          "e003",
          "e008",
          "e012"
        ],
        "description": "盲标/最终 event_labels 对旧计划和状态变化证据处理自相矛盾：e008 取消租车、e012 退款到账被标为 contradicting，e003 仅查看旧租车订单却被标为 supporting；e002 自驾路线在 labeled_events 内部为 contradicting，最终又成 related_interest。对“取消租车改乘市郊铁路”意图，e008/e012 应为核心 supporting，e002/e003 是变更前旧计划背景或被替代证据，不应作为支持新方案的强证据，更不能把取消退款当反证。",
        "suggested_action": "将 e008/e012 改标 supporting i001；e002/e003 改为 related_interest/旧计划背景，若需保留旧计划反证则统一标为 contradicting 并同步 conflicts；确保 labeled_events 与 event_labels 一致。"
      },
      {
        "issue_type": "status_mislabel",
        "severity": "medium",
        "event_ids": [
          "e024",
          "e025",
          "e027",
          "e028"
        ],
        "description": "盲标将 i001 标为 confirmed，但证据仅显示已支付车票和更新日历，未显示12月19日实际完成出行；Gold 为 planned。把未来计划标为 confirmed 会误表达状态变化。",
        "suggested_action": "将状态恢复为 planned；若数据集允许“预订已确认但未出行”的状态，应明确限定，不能标为已完成/confirmed 出行。"
      },
      {
        "issue_type": "causal_evidence_underweighted",
        "severity": "low",
        "event_ids": [
          "e005"
        ],
        "description": "e005 暴雪橙色预警是改乘市郊铁路的直接触发因素，盲标仅在 inferred_facts 中引用，关系仍为 related_interest；虽符合 Gold 的 optional_evidence，但在“方式调整”意图下因果链证据强度被弱化。",
        "suggested_action": "可保留 related_interest，但建议在 inferred_facts 或 supporting 说明中明确 e005 作为变更触发因素，避免仅当作泛兴趣浏览。"
      }
    ],
    "summary": "样本事件序列本身基本可支持“暴雪预警后取消租车改乘市郊铁路”，但盲标严重偏离 Gold：将方式调整意图改写成泛旅游意图，并把取消租车/退款到账这类关键状态变化标成 contradicting，反而把旧租车订单查看标成 supporting，同时把未出行的计划标为 confirmed。建议改标或重新生成盲标，不建议丢弃样本。"
  },
