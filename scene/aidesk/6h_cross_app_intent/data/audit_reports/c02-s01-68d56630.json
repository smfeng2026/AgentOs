    "issues": [
      {
        "issue_type": "supporting_misclassification",
        "severity": "high",
        "event_ids": [
          "e005",
          "e006",
          "e010",
          "e013",
          "e027"
        ],
        "description": "盲标把多条直接支撑客户拜访筹备与会议意图的证据降为 related_interest，且 supporting_event_ids 仅保留 e001/e003/e021/e025。e005/e006 是规格要求的即时通讯分工确认，e010 是规格要求的汇报材料查看，e027 是规格要求的客户办公楼路线搜索；e013 是向直属领导送审 v3 汇报材料，也属于直接筹备证据。将这些标为 related_interest 会削弱 required_evidence 覆盖检查。",
        "suggested_action": "将 e005、e006、e010、e027 至少改为 supporting；e013 可标为 supporting 或说明为辅助审阅证据。同步更新 supporting_event_ids 与 related_interest_event_ids，避免 required_evidence 被错误降级。"
      },
      {
        "issue_type": "missing_required_evidence",
        "severity": "medium",
        "event_ids": [
          "e009",
          "e010",
          "e013"
        ],
        "description": "规格要求“文档应用中查看并修改汇报材料”，但现有事件只有 browse_content 和 view_detail；e010 的 last_edited_time 是文档元数据，不能证明用户执行了修改。没有 docs_app 的 edit/update/保存动作。",
        "suggested_action": "补充一条 docs_app 编辑、保存或版本更新事件；或将 required_evidence 改为“查看汇报材料”，不要从元数据推断用户修改。"
      },
      {
        "issue_type": "label_conflict_or_blind_miss",
        "severity": "medium",
        "event_ids": [
          "e012"
        ],
        "description": "e012 在 labeled_events 中为 origin=related、relation=related_interest（搜索“标书打印装订”，可能与纸质材料准备相关，且 unknown_information 包含是否需要纸质材料），但盲标 event_labels 和 unrelated_event_ids 将其判为 unrelated。若该搜索确为会议纸质材料准备，盲标漏标；若确定为无关的标书任务，也应明确为干扰项。",
        "suggested_action": "建议裁决器按真实语义保留为 related_interest（低置信）或明确标注为 unrelated distractor；不要因单条打印搜索创建新意图，也不要无说明丢弃样本。"
      },
      {
        "issue_type": "temporal_inconsistency",
        "severity": "low",
        "event_ids": [
          "e025",
          "e027"
        ],
        "description": "e027 路线搜索的 planned_departure_time 为 12月11日13:00，而 e025 的出发提醒设为 13:15；若提醒表示实际出发时间，则晚于规划出发时间，且地铁方案可能迟到。",
        "suggested_action": "对齐提醒时间与规划出发时间，或将提醒文案改为“出发前检查/准备”以消除歧义。"
      }
    ],
    "summary": "意图本身有直接证据支持：客户邮件确认、用户回复、日历创建会议和出发提醒足以确认 meeting 目的。但盲标将多条 required_evidence 错误降为 related_interest，汇报材料缺少实际修改事件，e012 存在 related_interest/unrelated 标签冲突，且提醒时间与路线规划时间有小幅不一致，因此不通过。"
  },
